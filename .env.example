# Copie este archivo como .env antes de levantar docker compose.
# Opción A (recomendada): MongoDB en el contenedor incluido.
# Use solo letras y números en la contraseña; si pone @ : / # o ?, debe ir codificada en la URI.
MONGO_USER=helpdesk
MONGO_PASSWORD=
MONGO_DB=helpdesk_casma

# Opción B: servidor propio o MongoDB Atlas. Si define MONGO_URI, tiene prioridad
# sobre la opción A y el contenedor `mongo` queda sin usar.
# MONGO_URI=mongodb+srv://usuario:clave@cluster0.xxxxx.mongodb.net/?retryWrites=true&w=majority

# python3 -c "import secrets;print(secrets.token_urlsafe(48))"
JWT_SECRET=
# python3 -c "from cryptography.fernet import Fernet;print(Fernet.generate_key().decode())"
FIELD_ENCRYPTION_KEY=

# Puerto donde queda publicado el sistema
WEB_PORT=8080
PUBLIC_BASE_URL=http://10.10.1.5:8080

# Ponga true solo cuando el sistema quede detrás de HTTPS
COOKIE_SECURE=false

# Redes internas desde donde pueden ingresar las oficinas (vacío = sin restricción)
OFFICE_ALLOWED_NETWORKS=10.10.0.0/16,192.168.0.0/16

# tfidf | sentence-transformers
AI_EMBEDDINGS=tfidf
